# ---------------------------------------------------------------------------
# Inbound auth for this MCP server.
# REQUIRED in any deployment: without it, POST /mcp is public and will serve
# patient financial data to anyone who knows the URL. Generate with:
#   openssl rand -hex 32
# Clients pass it as "Authorization: Bearer <token>" or append ?key=<token>
# to the URL (the Claude connector UI only takes a URL, so use ?key= there).
MCP_AUTH_TOKEN=generate_a_long_random_string_here

# ---------------------------------------------------------------------------
# Ireland practice tokens (used by default for all queries).
# Up to 3 tokens are rotated. NOTE: rotation only raises your effective rate
# limit if the tokens map to separate Dentally quota buckets. If they share one
# bucket, get_rate_limit_status will say so — adding more tokens won't help.
# Duplicate values are collapsed, so don't paste the same token twice.
DENTALLY_API_TOKEN=your_ireland_dentally_api_token_here
DENTALLY_API_TOKEN_2=your_ireland_dentally_api_token_2_here
DENTALLY_API_TOKEN_3=your_ireland_dentally_api_token_3_here

# UK practice tokens (Manchester, Leeds, Glasgow, Enniskillen).
# Used only when a tool is called with region:"uk". Same rotation caveat.
DENTALLY_UK_API_TOKEN=your_uk_dentally_api_token_here
DENTALLY_UK_API_TOKEN_2=your_uk_dentally_api_token_2_here
DENTALLY_UK_API_TOKEN_3=your_uk_dentally_api_token_3_here
